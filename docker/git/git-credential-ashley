#!/bin/sh
# git credential helper for the agent container.
# Supplies a READ-ONLY GitHub token for pulling from github.com, read from
# /agent/secrets/github_read_token. If that file is missing, no credentials are
# offered and git works only with public repositories.
#
# Pushing is a separate matter: it is blocked by the pre-push hook, and the token
# should be created read-only on GitHub, so it could not push anyway.

[ "$1" = "get" ] || exit 0

file=/agent/secrets/github_read_token
[ -r "$file" ] || exit 0

host=""
while IFS='=' read -r key value; do
  [ "$key" = "host" ] && host="$value"
done
[ "$host" = "github.com" ] || exit 0

token=$(tr -d '\r\n ' < "$file")
[ -n "$token" ] || exit 0

echo "username=x-access-token"
echo "password=$token"
